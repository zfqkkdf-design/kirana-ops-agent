TELEGRAM_BOT_TOKEN=
# anthropic | gemini (default gemini so an existing .env keeps working)
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GOOGLE_API_KEY=
AGENT_HARNESS=langchain
# Comma-separated, tried in priority order with automatic fallback to the next on error.
# Ordered by measured latency (gemini-3.5-flash is a slow preview — ~50s even with
# minimal thinking — so it's last, used only if everything faster fails).
GEMINI_MODEL_PRIORITY=gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite,gemma-4-31b-it,gemma-4-26b-a4b-it,gemini-3.5-flash
DATABASE_URL=sqlite:///kirana_store.db